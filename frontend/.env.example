# ============================================================
# Rate Radar — environment variables
# Copy to .env for local use. In production these live in two places:
#   Vercel  → Project Settings → Environment Variables (site + ingest vars)
#   GitHub  → Repo Settings → Secrets and variables → Actions (collector vars)
# ============================================================

# --- Site access (Supabase Auth) ---
# Shared site password — the family's zero-setup sign-in (maps to a shared
# owner session). Personal accounts use email magic links below.
SITE_PASSWORD=change-me

# Always allowed to sign in with a magic link (role: owner) even before any
# invites exist. Other emails must be invited via Settings -> Team.
# NOTE: magic links send through Resend (RESEND_API_KEY below); on the free
# tier without a verified domain they only deliver to the Resend account
# owner's address.
OWNER_EMAIL=

# Bearer token the GitHub Actions collector uses to push data into /api/ingest.
# Generate: openssl rand -hex 32. Must be identical in Vercel AND GitHub secrets.
INGEST_SECRET=

# Vercel sends this as a Bearer token to the daily /api/cron/heartbeat.
# Required — the heartbeat refuses every request while it is unset.
# Generate: openssl rand -hex 32. Vercel only.
CRON_SECRET=

# --- Supabase (storage + auth) ---
# supabase.com → project → Project Settings → API. Run supabase/migrations/*.sql
# in the SQL editor once (docs/SETUP.md). All three are server-only: nothing is
# NEXT_PUBLIC, the browser never talks to Supabase directly.
# Leave SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY blank locally to store data in
# .data/store.json instead (demo mode). Signing in always needs a real project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend, free tier) ---
# Key from resend.com → API Keys.
RESEND_API_KEY=
# Who gets alerts. NOTE: without a verified domain, Resend free tier only
# delivers to the email address that OWNS the Resend account. Create the
# Resend account with the address you want alerts sent to. If you later
# verify a domain, this can be any list: a@x.com,b@y.com
ALERT_EMAIL_TO=
# Public URL of the deployed dashboard (used in the email footer link).
DASHBOARD_URL=https://your-project.vercel.app

# --- Event data APIs ---
# Free key: developer.ticketmaster.com → Get Your API Key (Discovery API).
# Use the "Consumer Key" — the consumer secret is NOT needed.
TICKETMASTER_API_KEY=
# Free key: collegefootballdata.com → API Keys (emailed to you).
CFBD_API_KEY=
# api.weather.gov requires a descriptive User-Agent identifying you + contact.
NWS_USER_AGENT=RateRadar-RRI1430 (your-email@example.com)

# --- DigitalFingerprint (OriginID) visitor identification (optional) ---
# Official CDN script-tag integration (SRI-pinned), landing page only.
# Identification stays OFF until the public key below is set.
# PUBLIC pk_ key — browser-visible by design (hostname-allowlisted).
NEXT_PUBLIC_ORIGINID_PUBLIC_KEY=
# Optional override of the SDK script source (self-hosted/first-party proxy);
# leave blank to use https://cdn.digitalfingerprintjs.com/v1/originid.global.js
NEXT_PUBLIC_ORIGINID_SCRIPT_URL=
# SECRET sk_ key for the server-side Events API (GET /api/events/{eventId}).
# Server only — NEVER expose as NEXT_PUBLIC_*.
ORIGINID_SECRET_API_KEY=

# --- Rate + compset prices (SerpApi, google_hotels engine) ---
# Collector only — this key never needs to reach Vercel.
# Free plan: 250 searches/month, resets on the signup anniversary (the collector
# reads plan_renewal_date from /account and paces itself against it).
# The search query and our own property_token live in config/properties.json,
# not here — they are not secrets and they differ per property.
SERPAPI_KEY=

# Bellhop (the chat on /analytics). Free key: https://aistudio.google.com
# Unset = Bellhop says it is unavailable; everything else works.
GEMINI_API_KEY=

# --- PostHog product analytics (optional) ---
# Off until the token is set. Project token (phc_...) from PostHog -> Project settings;
# browser-visible by design. Events are proxied through /ingest on our domain.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Ingestion host. Defaults to https://us.i.posthog.com; EU projects use https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
