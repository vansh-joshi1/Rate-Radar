{
  "name": "rate-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Internal rate recommendation + rate parity radar for Red Roof Inn Franklin, TN (RRI1430). Recommendation only - never changes prices.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "test": "vitest run",
    "collect": "tsx backend/collector/index.ts",
    "apikey": "cd frontend && tsx ../backend/scripts/create-api-key.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cheerio": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
